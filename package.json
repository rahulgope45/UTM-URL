{
  "name": "utm-attribution",
  "version": "1.0.0",
  "description": "Track where visitors come from (UTM + referrer), tie it to sales, and see which marketing platform earns the most",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  }
}
