# Copy to .env and adjust. Every value is optional.
PORT=3000
DB_FILE=data/utm.db
CURRENCY=INR

# Sites allowed to send tracking events (comma separated). Same origin always works.
ALLOWED_ORIGINS=https://yourshop.com

# Your backend must send this as the X-Conversion-Secret header when reporting sales.
CONVERSION_SECRET=change-me-to-a-long-random-string

# A visit can get credit for a sale made up to this many days later.
LOOKBACK_DAYS=30

# Set to false in production to remove the demo shop.
DEMO_STORE=true

# Optional: shorten links with your Kutt instance.
KUTT_URL=
KUTT_API_KEY=
