# Created for you by setup.sh; this file only documents the values.
# Never commit the real deploy/.env.

# Hostnames: sslip.io maps app.13-233-10-20.sslip.io -> 13.233.10.20
APP_HOST=app.13-233-10-20.sslip.io
KUTT_HOST=go.13-233-10-20.sslip.io

# Start Kutt too (remove the line to run without it)
COMPOSE_PROFILES=kutt

# App
CONVERSION_SECRET=<64 random hex chars>
ALLOWED_ORIGINS=
DEMO_STORE=true
CURRENCY=INR
LOOKBACK_DAYS=30

# Kutt
KUTT_JWT_SECRET=<64 random hex chars>
KUTT_URL=http://kutt:3000
# Paste after creating it in Kutt: Settings -> API key. Then: docker compose up -d
KUTT_API_KEY=
